# ─────────────────────────────────────────────────────────────────────────────
#  STM Dashboard — environment configuration
#  Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Port the dashboard server listens on.
PORT=3000

# ── STM (Société de transport de Montréal) ──────────────────────────────────
# Get a free developer key here:
#   https://www.stm.info/en/about/developers
# Register, request access to the GTFS-realtime API, then paste the key below.
# The static GTFS feed does not require a key; the realtime feeds do (sent as
# the `apikey` HTTP header on every request).
STM_API_KEY=l712e9aa14edcc489c9374e728f80cf2dc

# Static GTFS zip (route/stop/trip/schedule). Public, no key required.
# The default is the STM bus network feed.
STM_GTFS_STATIC_URL=https://www.stm.info/sites/default/files/gtfs/gtfs_stm.zip

# GTFS-realtime protobuf endpoints (require STM_API_KEY).
STM_GTFS_RT_TRIPUPDATES_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/tripUpdates
STM_GTFS_RT_VEHICLEPOSITIONS_URL=https://api.stm.info/pub/od/gtfs-rt/ic/v2/vehiclePositions
STM_GTFS_RT_ALERTS_URL=https://api.stm.info/pub/od/i3/v2/messages/etatservice

# When true (or when STM_API_KEY is empty) the STM adapter runs a built-in
# schedule simulator that produces data resembling the design mock, so the
# dashboard is fully functional out of the box with no key.
STM_USE_SIMULATOR=true

# ── Weather (Open-Meteo — no key required) ──────────────────────────────────
# Montreal coordinates by default. Override to relocate the display.
WEATHER_LATITUDE=45.4765
WEATHER_LONGITUDE=-73.6104
WEATHER_TIMEZONE=America/Toronto

# ── Crypto (BTC/USD) ────────────────────────────────────────────────────────
# Default adapter uses the public CoinGecko API (no key required).
# Set a key only if you switch to a keyed provider.
CRYPTO_API_KEY=

# ── News / ticker headlines ─────────────────────────────────────────────────
# Optional NewsAPI.org key. If empty, the ticker falls back to configured RSS
# feeds + STM alerts + inspirational quotes.
NEWS_API_KEY=
